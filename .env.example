# Environment
SITE_VERSION=
ENVIRONMENT=development

# API
ORIGIN=http://localhost:5173
DOMAIN=localhost
PORT=3001
HOST=0.0.0.0

# Web -> API proxy (apps/web /api/[...slug]); defaults to http://127.0.0.1:3001
API_PROXY_BASE_URL=http://127.0.0.1:3001

# Cloudflare
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Database
DATABASE_USER='postgres'
DATABASE_PASSWORD='postgres'
DATABASE_HOST='localhost'
DATABASE_PORT=5432
DATABASE_DB='postgres'

# Drizzle
LOG_LEVEL=debug
DB_MIGRATING=false
DB_SEEDING=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Emails
SITE_NAME=
SITE_URL=
SUPPORT_EMAIL=

# Redis
REDIS_URL=redis://localhost:6379

# Background jobs (BullMQ). Set false to skip registering queues/workers.
JOBS_ENABLED=true

# Security - openssl rand -hex 32
ENCRYPTION_KEY=
SIGNING_SECRET=

# Better Auth - BETTER_AUTH_SECRET: openssl rand -base64 32 (min 32 chars)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
TWO_FACTOR_ISSUER=AdelieStack

SHOW_OAUTH_BUTTONS=false

# Storage (SeaweedFS S3 locally; any S3-compatible provider in production)
# Buckets: ${PROJECT_NAME}-public-${ENVIRONMENT} and ${PROJECT_NAME}-private-${ENVIRONMENT}.
# Provision locally with `pnpm storage:setup`. Credentials must match docker/seaweedfs/s3-config.json.
PROJECT_NAME=adelie
PUBLIC_IMAGE_URI=http://localhost:8333/adelie-public-development
STORAGE_URL=http://localhost:8333
STORAGE_ACCESS_KEY=user
STORAGE_SECRET_KEY=password
STORAGE_HOST=localhost
STORAGE_PORT=8333
STORAGE_SSL=false

# Sentry
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=
SENTRY_BACKEND_URL=

# Public
PUBLIC_SITE_NAME=
PUBLIC_SITE_URL='http://$DOMAIN:5173'
PUBLIC_SITE_VERSION=
PUBLIC_SUPPORT_EMAIL=
PUBLIC_SENTRY_URL=

# Public Analytics
PUBLIC_UMAMI_URL=""
PUBLIC_UMAMI_ID=""

# quick setting for key-combo only
SVELTE_INSPECTOR_TOGGLE=control-shift-i

# Antivirus
ANTIVIRUS_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Email (Unsend)
API_KEY=""
API_BASE_URL="app.usesend.com/api/"

# OpenTelemetry (Observability)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
