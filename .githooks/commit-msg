#!/bin/sh
# Enforce Conventional Commits: type(scope)!: subject
# Merge, revert, fixup and squash commits are allowed as-is.
first_line=$(head -n 1 "$1")

case "$first_line" in
  "Merge "* | "merge: "* | "Revert "* | "fixup! "* | "squash! "*) exit 0 ;;
esac

if ! printf '%s\n' "$first_line" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'; then
  echo "commit-msg: subject must match 'type(scope): subject'."
  echo "Types: feat fix docs style refactor perf test build ci chore revert"
  echo "Example: feat(web): add error pages (#15)"
  exit 1
fi
