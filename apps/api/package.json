{
  "name": "@adelie/api",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "db:push": "drizzle-kit push --config ./drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "tsx src/lib/server/api/databases/postgres/migrate.ts",
    "db:seed": "tsx src/lib/server/api/databases/postgres/seed.ts",
    "auth:generate": "auth generate --config ./src/lib/server/api/auth/auth.cli.ts --output ./src/lib/server/api/auth/tables/auth.table.ts --yes && biome format --write ./src/lib/server/api/auth/tables/auth.table.ts",
    "db:studio": "drizzle-kit studio --config ./drizzle.config.ts --verbose",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --output-structure message-modules --strategy cookie preferredLanguage baseLocale --emit-ts-declarations --silent",
    "paraglide:watch": "pnpm paraglide:compile --watch",
    "dev": "pnpm paraglide:compile && NODE_OPTIONS=\"--inspect=9230\" tsx watch src/server.ts",
    "build": "pnpm paraglide:compile",
    "start": "tsx src/server.ts",
    "preview": "tsx src/server.ts",
    "test:unit": "vitest",
    "test": "pnpm test:unit -- --run",
    "test:valkey": "vitest run --config vitest.valkey.config.ts",
    "check": "pnpm paraglide:compile && tsc --noEmit -p tsconfig.json",
    "initialize": "pnpm install",
    "lint": "biome check .",
    "format": "biome format --write ./src",
    "site:update": "pnpm update -i -L"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*.ts"
  },
  "devDependencies": {
    "@adelie/test-utils": "workspace:*",
    "@biomejs/biome": "2.6.9",
    "@faker-js/faker": "^10.6.0",
    "@inlang/paraglide-js": "3.2.2",
    "@scalar/api-reference": "1.85.0",
    "@types/clamscan": "^2.4.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/pg-pool": "^2.0.7",
    "@vitest/coverage-v8": "5.1.2",
    "auth": "^1.7.28",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "5.1.2",
    "yaml": "2.9.1",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@adelie/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@better-auth/core": "1.7.28",
    "@better-auth/passkey": "1.7.28",
    "@hono/node-server": "^2.1.11",
    "@hono/otel": "^1.4.1",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@kubiks/otel-drizzle": "^2.1.0",
    "@needle-di/core": "^1.2.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@pilcrowjs/object-parser": "^0.0.4",
    "@scalar/hono-api-reference": "^0.12.26",
    "@sentry/node": "^11.19.0",
    "better-auth": "1.7.28",
    "bullmq": "^6.7.10",
    "clamscan": "^2.4.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "file-type": "^22.3.0",
    "hono": "^4.13.23",
    "hono-pino": "^0.10.3",
    "hono-rate-limiter": "^0.5.4",
    "hono-zod-openapi": "^1.1.1",
    "ioredis": "^6.1.0",
    "just-is-empty": "^3.4.1",
    "just-kebab-case": "^4.2.0",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "pg-pool": "^3.14.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^4.1.1",
    "sharp": "^0.35.5",
    "stoker": "^2.0.1",
    "tsx": "^4.23.15",
    "usesend-js": "^1.6.3",
    "varlock": "^1.25.0",
    "zod": "^4.6.7"
  }
}
