{
	"name": "@adelie/api",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"db:push": "drizzle-kit push --config ./drizzle.config.ts",
		"db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
		"db:migrate": "tsx src/lib/server/api/databases/postgres/migrate.ts",
		"db:seed": "tsx src/lib/server/api/databases/postgres/seed.ts",
		"db:studio": "drizzle-kit studio --config ./drizzle.config.ts --verbose",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy baseLocale --emit-ts-declarations --silent",
		"paraglide:watch": "pnpm paraglide:compile --watch",
		"dev": "pnpm paraglide:compile && NODE_OPTIONS=\"--inspect=9230\" tsx watch src/server.ts",
		"build": "pnpm paraglide:compile",
		"start": "tsx src/server.ts",
		"preview": "tsx src/server.ts",
		"test:unit": "pnpm paraglide:compile && vitest",
		"test": "pnpm test:unit -- --run",
		"check": "pnpm paraglide:compile && tsc --noEmit -p tsconfig.json",
		"initialize": "pnpm install",
		"lint": "biome format ./src",
		"format": "biome format --write ./src",
		"site:update": "pnpm update -i -L"
	},
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@faker-js/faker": "^10.4.0",
		"@inlang/paraglide-js": "2.22.0",
		"@types/clamscan": "^2.4.1",
		"@types/node": "^24.10.1",
		"@types/pg": "^8.20.0",
		"@types/pg-pool": "^2.0.7",
		"@vitest/coverage-v8": "4.1.8",
		"drizzle-kit": "^0.31.10",
		"typescript": "^6.0.3",
		"vitest": "4.1.8",
		"zod": "^4.3.6"
	},
	"dependencies": {
		"@adelie/shared": "workspace:*",
		"@aws-sdk/client-s3": "^3.1139.0",
		"@hono/node-server": "^2.0.0",
		"@hono/otel": "^1.1.1",
		"@hono/swagger-ui": "^0.6.1",
		"@hono/zod-openapi": "^1.3.0",
		"@hono/zod-validator": "^0.7.6",
		"@kubiks/otel-drizzle": "^2.1.0",
		"@needle-di/core": "^1.1.2",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/auto-instrumentations-node": "0.78.0",
		"@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
		"@opentelemetry/resources": "2.10.0",
		"@opentelemetry/sdk-node": "0.221.0",
		"@opentelemetry/semantic-conventions": "1.43.0",
		"@oslojs/binary": "^1.0.0",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@oslojs/jwt": "^0.3.0",
		"@oslojs/oauth2": "^0.5.0",
		"@oslojs/otp": "^1.0.0",
		"@oslojs/webauthn": "^1.0.0",
		"@pilcrowjs/object-parser": "^0.0.4",
		"@scalar/hono-api-reference": "^0.10.10",
		"@sentry/node": "^10.50.0",
		"arctic": "^3.7.0",
		"argon2": "^0.44.0",
		"bullmq": "^5.76.2",
		"clamscan": "^2.4.0",
		"dayjs": "^1.11.20",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.12.15",
		"hono-pino": "^0.10.3",
		"hono-rate-limiter": "^0.5.3",
		"hono-zod-openapi": "^1.1.1",
		"ioredis": "^5.10.1",
		"just-is-empty": "^3.4.1",
		"just-kebab-case": "^4.2.0",
		"nanoid": "^5.1.9",
		"pg": "^8.20.0",
		"pg-pool": "^3.13.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"postgres": "^3.4.9",
		"sharp": "^0.34.4",
		"stoker": "^2.0.1",
		"tsx": "^4.21.0",
		"uqr": "^0.1.3",
		"usesend-js": "^1.6.3",
		"varlock": "^1.20.0",
		"zod": "^4.3.6"
	}
}
