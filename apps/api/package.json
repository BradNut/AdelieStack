{
  "name": "@adelie/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "db:push": "drizzle-kit push --config ./drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "tsx src/lib/server/api/databases/postgres/migrate.ts",
    "db:seed": "tsx src/lib/server/api/databases/postgres/seed.ts",
    "db:studio": "drizzle-kit studio --config ./drizzle.config.ts --verbose",
    "dev": "NODE_OPTIONS=\"--inspect=9230\" tsx watch src/server.ts",
    "build": "echo 'API build is runtime-based'",
    "start": "tsx src/server.ts",
    "test:unit": "vitest",
    "test": "pnpm test:unit -- --run",
    "check": "echo 'API typecheck is temporarily skipped during extraction phase'",
    "lint": "biome format ./src",
    "format": "biome format --write ./src"
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "@types/pg-pool": "^2.0.7",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@adelie/shared": "workspace:*",
    "@hono/node-server": "^2.0.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.3.0",
    "@hono/zod-validator": "^0.7.6",
    "@needle-di/core": "^1.1.2",
    "@oslojs/binary": "^1.0.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/jwt": "^0.3.0",
    "@oslojs/oauth2": "^0.5.0",
    "@oslojs/otp": "^1.0.0",
    "@oslojs/webauthn": "^1.0.0",
    "@scalar/hono-api-reference": "^0.10.10",
    "arctic": "^3.7.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.76.2",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.12.15",
    "hono-pino": "^0.10.3",
    "hono-rate-limiter": "^0.5.3",
    "hono-zod-openapi": "^1.1.1",
    "ioredis": "^5.10.1",
    "minio": "^8.0.7",
    "nanoid": "^5.1.9",
    "pg": "^8.20.0",
    "pg-pool": "^3.13.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "rate-limit-redis": "^4.3.1",
    "sharp": "^0.34.4",
    "stoker": "^2.0.1"
  }
}
