# This env file uses @env-spec - see https://varlock.dev/env-spec for more info.
# It is the single declared source of truth for API env vars: every variable
# the API reads must be listed here with a type, required-ness, and a description.
# Real values live in `.env` (local, gitignored) or `.env.local` (personal overrides,
# gitignored, highest precedence) — never commit real secrets here.
#
# Optional: pull secrets from a password manager instead of a local file. Varlock has plugins for
# Proton Pass, 1Password, Bitwarden and others (https://varlock.dev/plugins). For example, with
# Proton Pass, add `# @plugin(@varlock/proton-pass-plugin)` and `# @initProtonPass(id=prod)` to the
# header and set `SIGNING_SECRET=protonPass(prod, pass://<vault>/<item>/<field>)`. Install the plugin
# as an API dev dependency first. The defaults below stay plain so a fresh clone works without one.
#
# @defaultRequired=infer @defaultSensitive=inferFromPrefix('PUBLIC_')
# @generateTsTypes(path=env.d.ts)
# ---

# Environment
# @type=enum(development, staging, production) @sensitive=false
ENVIRONMENT=development
# Legacy short-form environment flag consumed by several services (dev/prod only).
# @type=enum(dev, prod) @sensitive=false
ENV=dev
# @type=enum(development, production) @sensitive=false @required=false
NODE_ENV=development

# Server
# @type=url @sensitive=false
ORIGIN=http://localhost:5173
# @type=string @sensitive=false
DOMAIN=localhost
# @type=number(min=1) @sensitive=false
PORT=3001
# @type=string @sensitive=false @required=false
HOST=0.0.0.0
# @type=string @sensitive=false
LOG_LEVEL=debug
# @type=semver @sensitive=false @required=false
SITE_VERSION=

# Database
# @type=string @sensitive=false
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# @type=string @sensitive=false
DATABASE_HOST=localhost
# @type=number(min=1) @sensitive=false
DATABASE_PORT=5432
# @type=string @sensitive=false
DATABASE_DB=postgres

# Drizzle / seed. Read only by the migrate and seed scripts, which refuse to run unless their flag
# is "true". The running API ignores both. Off by default, so set them per command.
# @type=boolean @sensitive=false
DB_MIGRATING=false
# @type=boolean @sensitive=false
DB_SEEDING=false
# Seeded admin user (`pnpm db:seed`). Without ADMIN_PASSWORD the admin is skipped (with a warning).
# @type=email @sensitive=false @required=false
ADMIN_EMAIL=admin@example.com
# @required=false
ADMIN_PASSWORD=
# Allow anyone to register an account. Closed by default: users then come from the seeded admin
# and the admin plugin's create-user. Set to true for local dev and the e2e suite, which sign up users.
# @type=boolean @sensitive=false
SIGN_UP_ENABLED=false

# Social login (optional). A provider is on only when both its client id and secret are set; with none
# set, no provider is registered and the login page shows no social buttons. The OAuth callback URL to
# register with each provider is `${BETTER_AUTH_URL}/api/auth/callback/<github|google>`.
# @type=string @required=false @sensitive=false
GITHUB_CLIENT_ID=
# @type=string @required=false @sensitive
GITHUB_CLIENT_SECRET=
# @type=string @required=false @sensitive=false
GOOGLE_CLIENT_ID=
# @type=string @required=false @sensitive
GOOGLE_CLIENT_SECRET=

# Security
# Generate with: openssl rand -hex 32
# @type=string @required @sensitive
SIGNING_SECRET=
# Better Auth secret for signing/encrypting auth cookies and tokens (min 32 chars).
# Generate with: openssl rand -base64 32
# @type=string(minLength=32) @required @sensitive
BETTER_AUTH_SECRET=
# Public base URL the auth endpoints are served from: the web origin, which proxies /api here.
# @type=url @sensitive=false
BETTER_AUTH_URL=http://localhost:5173
# Name shown in authenticator apps when a user enrols TOTP two-factor.
# @type=string @sensitive=false
TWO_FACTOR_ISSUER=AdelieStack
# Passkey relying-party id: the registrable domain the web app is served from (no scheme or port).
# @type=string @sensitive=false
PASSKEY_RP_ID=localhost
# Name shown in the browser's passkey prompt.
# @type=string @sensitive=false
PASSKEY_RP_NAME=AdelieStack
# Trust proxy headers (X-Forwarded-For) when resolving the client IP for rate limiting.
# Enable only behind a trusted reverse proxy (the web app's /api proxy counts). With it off, auth rate
# limiting puts every client in one bucket per path, so ENV=prod refuses to start unless this is true
# or DISABLE_RATE_LIMIT is true.
# @type=boolean @sensitive=false
TRUST_PROXY=false
# Comma-separated IPs or CIDR ranges of the proxies that append to X-Forwarded-For, such as
# 10.0.0.0/8,192.0.2.10. Both rate limiters strip these from the right of the header to find the client.
# Leave empty when the proxy sets the header to one address (the web app's /api proxy does). An invalid
# entry refuses startup. Read only with TRUST_PROXY=true.
# @type=string @sensitive=false
TRUSTED_PROXIES=
# Allow a user to hold several roles (stored comma-separated). When false, a multi-valued role is
# treated as invalid and the user gets the least-privileged role.
# @type=boolean @sensitive=false
ALLOW_MULTIPLE_ROLES=false
# Kill switch for rate limiting; set true in tests/controlled environments.
# @type=boolean @sensitive=false
DISABLE_RATE_LIMIT=false

# Redis
# @type=url @sensitive=false
REDIS_URL=redis://localhost:6379

# Background jobs
# Register BullMQ queues/workers on startup. Set false in tests/CI or processes
# that must not open a Redis worker connection. While true, Redis must answer within 10s or the
# API refuses to start.
# Includes audit cleanup: weekly, it permanently deletes audit rows older than 90 days.
# @type=boolean @sensitive=false
JOBS_ENABLED=true

# Email
# Transport selector: 'mailpit' posts to the local Mailpit inbox; 'unsend' sends for real through useSend.
# With 'unsend', USESEND_API_KEY and MAIL_FROM are required and the API refuses to start without them.
# With 'mailpit', none of the three variables below is read.
# @type=enum(mailpit, unsend) @sensitive=false
MAILER_TRANSPORT=mailpit
# useSend API key.
# @type=string @required=false @sensitive
USESEND_API_KEY=
# Sender address; must be on a domain verified in useSend.
# @type=string @required=false @sensitive=false
MAIL_FROM=
# The server's address only, e.g. https://app.usesend.com or a self-hosted useSend. The library appends
# /api/v1 itself, so do not include /api. Leave unset for https://app.usesend.com.
# @type=string @required=false @sensitive=false
USESEND_BASE_URL=

# Storage (SeaweedFS S3 locally; any S3-compatible provider in production).
# Buckets: ${PROJECT_NAME}-public-${ENVIRONMENT} and ${PROJECT_NAME}-private-${ENVIRONMENT}.
# The API creates missing buckets at startup and refuses to start if storage is unreachable.
# `pnpm storage:setup` provisions them without starting the API. Credentials must match docker/seaweedfs/s3-config.json.
# @type=string @sensitive=false
PROJECT_NAME=adelie
# @type=url @sensitive=false
STORAGE_URL=http://localhost:8333
STORAGE_ACCESS_KEY=adelie-local-access-key
STORAGE_SECRET_KEY=adelie-local-secret-key
# @type=string @sensitive=false
STORAGE_HOST=localhost
# @type=number(min=1) @sensitive=false
STORAGE_PORT=8333
# @type=boolean @sensitive=false
STORAGE_SSL=false
# @sensitive=false
PUBLIC_IMAGE_URI=http://localhost:8333/adelie-public-development
# Shared bearer secret the storage provider must send on object-created webhooks.
# Leave empty to accept unauthenticated webhooks (local dev only).
# @type=string @required=false @sensitive
STORAGE_WEBHOOK_SECRET=

# Breached-password screening (Have I Been Pwned)
# Rejects breached passwords on sign-up and password changes. While on, an unreachable HIBP rejects
# the request. Set to false and restart to bypass an HIBP outage.
# @type=boolean @sensitive=false
HIBP_ENABLED=true

# Captcha on anonymous auth endpoints (sign-up, sign-in, password reset, verification email)
# Off by default. When on, CAPTCHA_PROVIDER, CAPTCHA_SECRET_KEY and CAPTCHA_SITE_KEY are required.
# An unreachable provider rejects the request (503). Set to false and restart to bypass an outage.
# @type=boolean @sensitive=false
CAPTCHA_ENABLED=false
# One of: cloudflare-turnstile, google-recaptcha, hcaptcha, captchafox.
# @type=enum(cloudflare-turnstile, google-recaptcha, hcaptcha, captchafox) @required=false @sensitive=false
CAPTCHA_PROVIDER=
# Provider secret; stays on the API and is never sent to the web.
# @type=string @required=false @sensitive
CAPTCHA_SECRET_KEY=
# Public site key; the web reads it from GET /api/config/captcha.
# @type=string @required=false @sensitive=false
CAPTCHA_SITE_KEY=
# reCAPTCHA v3 only: reject scores below this (0 to 1, provider default 0.5).
# @type=number(min=0, max=1) @required=false @sensitive=false
CAPTCHA_MIN_SCORE=

# Antivirus (ClamAV)
# When enabled, uploads are scanned by a clamd daemon before they are persisted and
# infected files are rejected. Disable to skip scanning entirely.
# @type=boolean @sensitive=false
ANTIVIRUS_ENABLED=false
# Host/port of the clamd daemon (TCP).
# @type=string @sensitive=false
CLAMAV_HOST=localhost
# @type=number(min=1) @sensitive=false
CLAMAV_PORT=3310

# Sentry (backend)
# @type=url @sensitive=false @required=false
SENTRY_BACKEND_URL=

# OpenTelemetry (Observability)
# @type=boolean @sensitive=false
OTEL_ENABLED=false
# @type=url @sensitive=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
