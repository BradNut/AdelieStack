# This env file uses @env-spec - see https://varlock.dev/env-spec for more info.
# It is the single declared source of truth for API env vars: every variable
# the API reads must be listed here with a type, required-ness, and a description.
# Real values live in `.env` (local, gitignored) or `.env.local` (personal overrides,
# gitignored, highest precedence) — never commit real secrets here.
#
# Optional: pull secrets from a password manager instead of a local file. Varlock has plugins for
# Proton Pass, 1Password, Bitwarden and others (https://varlock.dev/plugins). For example, with
# Proton Pass, add `# @plugin(@varlock/proton-pass-plugin)` and `# @initProtonPass(id=prod)` to the
# header and set `SIGNING_SECRET=protonPass(prod, pass://<vault>/<item>/<field>)`. Install the plugin
# as an API dev dependency first. The defaults below stay plain so a fresh clone works without one.
#
# @defaultRequired=infer @defaultSensitive=inferFromPrefix('PUBLIC_')
# @generateTsTypes(path=env.d.ts)
# ---

# Environment
# @type=enum(development, staging, production) @sensitive=false
ENVIRONMENT=development
# Legacy short-form environment flag consumed by several services (dev/prod only).
# @type=enum(dev, prod) @sensitive=false
ENV=dev
# @type=enum(development, production) @sensitive=false @required=false
NODE_ENV=development

# Server
# @type=url @sensitive=false
ORIGIN=http://localhost:5173
# @type=string @sensitive=false
DOMAIN=localhost
# @type=number(min=1) @sensitive=false
PORT=3001
# @type=string @sensitive=false @required=false
HOST=0.0.0.0
# @type=string @sensitive=false
LOG_LEVEL=debug
# @type=semver @sensitive=false @required=false
SITE_VERSION=

# Database
# @type=string @sensitive=false
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# @type=string @sensitive=false
DATABASE_HOST=localhost
# @type=number(min=1) @sensitive=false
DATABASE_PORT=5432
# @type=string @sensitive=false
DATABASE_DB=postgres

# Drizzle / seed
# @type=boolean @sensitive=false
DB_MIGRATING=false
# @type=boolean @sensitive=false
DB_SEEDING=false
# Seeded admin user (`pnpm db:seed`). Without ADMIN_PASSWORD the admin is skipped (with a warning).
# @type=email @sensitive=false @required=false
ADMIN_EMAIL=admin@example.com
# @required=false
ADMIN_PASSWORD=

# Security
# Generate with: openssl rand -hex 32
# @type=string @required @sensitive
SIGNING_SECRET=
# Better Auth secret for signing/encrypting auth cookies and tokens (min 32 chars).
# Generate with: openssl rand -base64 32
# @type=string(minLength=32) @required @sensitive
BETTER_AUTH_SECRET=
# Public base URL the auth endpoints are served from: the web origin, which proxies /api here.
# @type=url @sensitive=false
BETTER_AUTH_URL=http://localhost:5173
# Name shown in authenticator apps when a user enrols TOTP two-factor.
# @type=string @sensitive=false
TWO_FACTOR_ISSUER=AdelieStack
# Passkey relying-party id: the registrable domain the web app is served from (no scheme or port).
# @type=string @sensitive=false
PASSKEY_RP_ID=localhost
# Name shown in the browser's passkey prompt.
# @type=string @sensitive=false
PASSKEY_RP_NAME=AdelieStack
# Trust proxy headers (X-Forwarded-For) when resolving the client IP for rate limiting.
# Enable only behind a trusted reverse proxy.
# @type=boolean @sensitive=false
TRUST_PROXY=false
# Kill switch for rate limiting; set true in tests/controlled environments.
# @type=boolean @sensitive=false
DISABLE_RATE_LIMIT=false

# Redis
# @type=url @sensitive=false
REDIS_URL=redis://localhost:6379

# Background jobs
# Register BullMQ queues/workers on startup. Set false in tests/CI or processes
# that must not open a Redis worker connection.
# @type=boolean @sensitive=false
JOBS_ENABLED=true

# Email
# Transport selector: 'mailpit' posts to the local Mailpit inbox; 'unsend' sends for real.
# @type=enum(mailpit, unsend) @sensitive=false
MAILER_TRANSPORT=mailpit

# Storage (SeaweedFS S3 locally; any S3-compatible provider in production).
# Buckets: ${PROJECT_NAME}-public-${ENVIRONMENT} and ${PROJECT_NAME}-private-${ENVIRONMENT}.
# Provision locally with `pnpm storage:setup`. Credentials must match docker/seaweedfs/s3-config.json.
# @type=string @sensitive=false
PROJECT_NAME=adelie
# @type=url @sensitive=false
STORAGE_URL=http://localhost:8333
STORAGE_ACCESS_KEY=adelie-local-access-key
STORAGE_SECRET_KEY=adelie-local-secret-key
# @type=string @sensitive=false
STORAGE_HOST=localhost
# @type=number(min=1) @sensitive=false
STORAGE_PORT=8333
# @type=boolean @sensitive=false
STORAGE_SSL=false
# @sensitive=false
PUBLIC_IMAGE_URI=http://localhost:8333/adelie-public-development
# Shared bearer secret the storage provider must send on object-created webhooks.
# Leave empty to accept unauthenticated webhooks (local dev only).
# @type=string @required=false @sensitive
STORAGE_WEBHOOK_SECRET=

# Antivirus (ClamAV)
# When enabled, uploads are scanned by a clamd daemon before they are persisted and
# infected files are rejected. Disable to skip scanning entirely.
# @type=boolean @sensitive=false
ANTIVIRUS_ENABLED=false
# Host/port of the clamd daemon (TCP).
# @type=string @sensitive=false
CLAMAV_HOST=localhost
# @type=number(min=1) @sensitive=false
CLAMAV_PORT=3310

# Sentry (backend)
# @type=url @sensitive=false @required=false
SENTRY_BACKEND_URL=

# OpenTelemetry (Observability)
# @type=boolean @sensitive=false
OTEL_ENABLED=false
# @type=url @sensitive=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
