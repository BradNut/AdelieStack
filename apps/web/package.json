  "type": "module",
  "dependencies": {
    "@adelie/api-contract": "workspace:*",
    "@adelie/shared": "workspace:*",
    "@inlang/paraglide-sveltekit": "^0.15.5",
    "@internationalized/date": "^3.12.1",
    "@oslojs/binary": "^1.0.0",
    "@oslojs/crypto": "^1.0.1",
