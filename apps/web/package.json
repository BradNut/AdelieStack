{
  "name": "@adelie/web",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=\"--inspect=9229\" vite dev --host",
    "build": "vite build",
    "build:low-mem": "VIPS_CONCURRENCY=1 UV_THREADPOOL_SIZE=2 vite build",
    "sync": "svelte-kit sync",
    "start": "node build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test": "pnpm test:unit -- --run",
    "test:e2e:deps": "npx playwright install chromium firefox webkit",
    "test:e2e": "varlock run --path ../api/ --inject vars --filter 'ADMIN_PASSWORD,DATABASE_HOST,DATABASE_PORT,REDIS_URL' -- playwright test",
    "test:e2e:dev": "playwright test --config=playwright.config.dev.ts",
    "test:ui": "svelte-kit sync && playwright test --ui",
    "test:ui:dev": "svelte-kit sync && playwright test --ui --config=playwright.config.dev.ts",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale --emit-ts-declarations --silent",
    "check": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm check:shared-boundaries",
    "check:shared-boundaries": "node ../../scripts/check-shared-boundaries.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "initialize": "pnpm install",
    "lint": "biome format ./src",
    "format": "biome format --write ./src",
    "storybook": "storybook dev -p 6006",
    "site:update": "pnpm update -i -L",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "devDependencies": {
    "@adelie/test-utils": "workspace:*",
    "@biomejs/biome": "2.6.8",
    "@chromatic-com/storybook": "^5.6.0",
    "@dicebear/converter": "^10.7.0",
    "@dicebear/core": "^10.7.0",
    "@faker-js/faker": "^10.6.0",
    "@inlang/cli": "^3.6.0",
    "@inlang/paraglide-js": "2.29.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.78.0",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/addon-svelte-csf": "^5.1.6",
    "@storybook/sveltekit": "10.6.8",
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/enhanced-img": "1.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/pg-pool": "^2.0.7",
    "@types/qrcode": "^1.5.6",
    "@varlock/vite-integration": "^1.5.6",
    "@vitest/coverage-v8": "5.1.1",
    "autoprefixer": "^10.7.0",
    "bits-ui": "2.22.0",
    "bullmq": "^6.7.8",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "drizzle-kit": "^0.31.11",
    "embla-carousel": "^8.6.0",
    "embla-carousel-svelte": "^8.6.0",
    "jsdom": "^26.1.0",
    "mode-watcher": "^1.1.0",
    "pg": "^8.23.1",
    "storybook": "10.6.8",
    "svelte-check": "4.7.8",
    "svelte-meta-tags": "^5.0.3",
    "svelte-preprocess": "^6.0.5",
    "svelte-render-scan": "^1.1.0",
    "svelte-sequential-preprocessor": "^2.0.3",
    "svelte-sonner": "^1.2.3",
    "sveltekit-flash-message": "^3.0.0",
    "sveltekit-rate-limiter": "^0.8.0",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "zod": "^4.6.7"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@adelie/api-contract": "workspace:*",
    "@adelie/shared": "workspace:*",
    "@better-auth/passkey": "1.7.27",
    "@dicebear/styles": "^10.6.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@sentry/browser": "^11.16.0",
    "@sentry/node": "^11.16.0",
    "@sentry/sveltekit": "^11.16.0",
    "@sveltejs/kit": "3.4.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/table-core": "^9.3.1",
    "@unpic/svelte": "^1.0.1",
    "better-auth": "1.7.27",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.10",
    "hono": "^4.13.21",
    "import-in-the-middle": "^3.6.0",
    "just-is-empty": "^3.4.1",
    "just-kebab-case": "^4.2.0",
    "paneforge": "1.0.2",
    "runed": "^0.38.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "svelte": "5.59.1",
    "sveltekit-superforms": "^3.1.0",
    "uqr": "^0.1.3",
    "varlock": "^1.25.0"
  }
}
