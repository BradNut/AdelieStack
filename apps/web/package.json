{
  "name": "@adelie/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=\"--inspect=9229\" vite dev --host",
    "build": "vite build",
    "build:low-mem": "VIPS_CONCURRENCY=1 UV_THREADPOOL_SIZE=2 vite build",
    "sync": "svelte-kit sync",
    "start": "node build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test": "pnpm test:unit -- --run && pnpm test:e2e",
    "test:e2e:deps": "npx playwright install chromium firefox webkit",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config=playwright.config.dev.ts",
    "test:ui": "svelte-kit sync && playwright test --ui",
    "test:ui:dev": "svelte-kit sync && playwright test --ui --config=playwright.config.dev.ts",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie baseLocale --emit-ts-declarations --silent",
    "check": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm check:shared-boundaries",
    "check:shared-boundaries": "node ../../scripts/check-shared-boundaries.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "initialize": "pnpm install",
    "lint": "biome format ./src",
    "format": "biome format --write ./src",
    "storybook": "storybook dev -p 6006",
    "site:update": "pnpm update -i -L",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "devDependencies": {
    "@adelie/test-utils": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@chromatic-com/storybook": "^5.5.1",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/converter": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@faker-js/faker": "^10.6.0",
    "@inlang/cli": "^3.4.2",
    "@inlang/paraglide-js": "2.27.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.56.0",
    "@playwright/test": "1.64.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-svelte-csf": "^5.1.5",
    "@storybook/sveltekit": "10.6.2",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/enhanced-img": "0.11.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/pg-pool": "^2.0.7",
    "@types/qrcode": "^1.5.6",
    "@varlock/vite-integration": "^1.5.3",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.6.1",
    "bits-ui": "2.19.5",
    "bullmq": "^5.76.2",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "drizzle-kit": "^0.31.11",
    "embla-carousel": "^8.6.0",
    "embla-carousel-svelte": "^8.6.0",
    "formsnap": "^2.0.1",
    "jsdom": "^26.1.0",
    "mode-watcher": "^1.1.0",
    "storybook": "10.6.2",
    "svelte-check": "4.7.6",
    "svelte-meta-tags": "^4.6.0",
    "svelte-preprocess": "^6.0.5",
    "svelte-render-scan": "^1.1.0",
    "svelte-sequential-preprocessor": "^2.0.3",
    "svelte-sonner": "^1.2.1",
    "sveltekit-flash-message": "^3.0.0",
    "sveltekit-rate-limiter": "^0.8.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "8.3.4",
    "vitest": "4.1.10",
    "zod": "^4.6.7"
  },
  "type": "module",
  "dependencies": {
    "@adelie/api-contract": "workspace:*",
    "@adelie/shared": "workspace:*",
    "@better-auth/passkey": "1.7.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.81.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@sentry/browser": "^10.50.0",
    "@sentry/node": "^10.50.0",
    "@sentry/sveltekit": "^10.50.0",
    "@sveltejs/kit": "2.70.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/table-core": "^8.21.3",
    "@unpic/svelte": "^1.0.1",
    "better-auth": "1.7.7",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "hono": "^4.13.13",
    "import-in-the-middle": "^3.5.2",
    "just-is-empty": "^3.4.1",
    "just-kebab-case": "^4.2.0",
    "nanoid": "^5.1.9",
    "paneforge": "1.0.2",
    "runed": "^0.37.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "svelte": "5.57.2",
    "sveltekit-superforms": "^2.30.1",
    "uqr": "^0.1.3",
    "varlock": "^1.22.0"
  }
}
