    "@sveltejs/kit": "2.70.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/table-core": "^8.21.3",
    "@unpic/svelte": "^1.0.1",
    "arctic": "^3.7.0",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "hono": "^4.12.15",
    "import-in-the-middle": "^3.0.1",
    "just-is-empty": "^3.4.1",
    "just-kebab-case": "^4.2.0",
    "nanoid": "^5.1.9",
    "paneforge": "1.0.2",
    "runed": "^0.37.1",
    "sharp": "^0.34.4",
    "sonner": "^2.0.7",
    "svelte": "5.56.7",
    "sveltekit-superforms": "^2.30.1",
    "uqr": "^0.1.3",
    "varlock": "^1.20.0"
  }
}
