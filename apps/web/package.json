{
  "name": "@adelie/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=\"--inspect=9229\" vite dev --host",
    "build": "vite build",
    "build:low-mem": "VIPS_CONCURRENCY=1 UV_THREADPOOL_SIZE=2 vite build",
    "sync": "svelte-kit sync",
    "start": "node build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test": "pnpm test:unit -- --run && pnpm test:e2e",
    "test:e2e:deps": "npx playwright install chromium firefox webkit",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config=playwright.config.dev.ts",
    "test:ui": "svelte-kit sync && playwright test --ui",
    "test:ui:dev": "svelte-kit sync && playwright test --ui --config=playwright.config.dev.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm check:shared-boundaries && pnpm check:agent-rules",
    "check:shared-boundaries": "node ../../scripts/check-shared-boundaries.mjs",
    "check:agent-rules": "node ../../scripts/check-agent-rules.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "initialize": "pnpm install",
    "lint": "biome format ./src",
    "format": "biome format --write ./src",
    "storybook": "storybook dev -p 6006",
    "site:update": "pnpm update -i -L",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@chromatic-com/storybook": "^5.1.2",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/converter": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@faker-js/faker": "^10.4.0",
    "@inlang/cli": "^3.1.10",
    "@inlang/paraglide-js": "2.22.0",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.11.0",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.5.3",
    "@storybook/addon-docs": "10.5.3",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/sveltekit": "10.5.3",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/enhanced-img": "0.11.0",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "@types/pg-pool": "^2.0.7",
    "@types/qrcode": "^1.5.6",
    "@varlock/vite-integration": "^1.5.2",
    "@vitest/coverage-v8": "4.1.10",
    "arctic": "^1.9.2",
    "autoprefixer": "^10.5.0",
    "bits-ui": "2.18.0",
    "bullmq": "^5.76.2",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "embla-carousel": "^8.6.0",
    "embla-carousel-svelte": "^8.6.0",
    "formsnap": "^2.0.1",
    "mode-watcher": "^1.1.0",
    "storybook": "10.5.3",
    "svelte-check": "4.7.3",
    "svelte-meta-tags": "^4.6.0",
    "svelte-preprocess": "^6.0.3",
    "svelte-render-scan": "^1.1.0",
    "svelte-sequential-preprocessor": "^2.0.3",
    "svelte-sonner": "^1.1.1",
    "svelte-turnstile": "^0.11.0",
    "sveltekit-flash-message": "^2.4.5",
    "sveltekit-rate-limiter": "^0.7.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "zod": "^4.3.6"
  },
  "type": "module",
  "dependencies": {
    "@adelie/api-contract": "workspace:*",
    "@adelie/shared": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.78.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.220.0",
