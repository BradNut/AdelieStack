{
  "name": "@adelie/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=\"--inspect=9229\" vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test": "pnpm test:unit -- --run && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:ui": "svelte-kit sync && playwright test --ui",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome format ./src",
    "format": "biome format --write ./src",
    "storybook": "storybook dev -p 6006",
    "site:update": "pnpm update -i -L"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@chromatic-com/storybook": "^5.1.2",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/converter": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/sveltekit": "^10.3.5",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/enhanced-img": "^0.9.2",
    "@sveltejs/kit": "^2.58.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/cookie": "^1.0.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "@types/pg-pool": "^2.0.7",
    "@types/qrcode": "^1.5.6",
    "arctic": "^1.9.2",
    "autoprefixer": "^10.5.0",
    "bits-ui": "2.18.0",
    "bullmq": "^5.76.2",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "formsnap": "^2.0.1",
    "lucide-svelte": "^1.0.1",
    "mode-watcher": "^1.1.0",
    "storybook": "^10.3.5",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.6",
    "svelte-meta-tags": "^4.6.0",
    "svelte-preprocess": "^6.0.3",
    "svelte-sequential-preprocessor": "^2.0.3",
    "svelte-sonner": "^1.1.1",
    "sveltekit-flash-message": "^2.4.5",
    "sveltekit-superforms": "^2.22.1",
