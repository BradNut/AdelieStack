{
  "name": "adelie-stack-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "db:push": "pnpm --filter @adelie/api db:push",
    "db:generate": "pnpm --filter @adelie/api db:generate",
    "db:migrate": "pnpm --filter @adelie/api db:migrate",
    "db:seed": "pnpm --filter @adelie/api db:seed",
    "db:studio": "pnpm --filter @adelie/api db:studio",
    "turbo": "turbo",
    "dev": "pnpm turbo run dev --filter=@adelie/web --filter=@adelie/api",
    "dev:web": "pnpm --filter @adelie/web dev",
    "dev:api": "pnpm --filter @adelie/api dev",
    "build": "pnpm turbo run build --filter=@adelie/web --filter=@adelie/api",
    "build:web": "pnpm turbo run build --filter=@adelie/web",
    "build:api": "pnpm turbo run build --filter=@adelie/api",
    "preview": "pnpm --filter @adelie/web preview",
    "test:unit": "pnpm turbo run test:unit --filter=@adelie/web --filter=@adelie/api",
    "test": "pnpm turbo run test --filter=@adelie/web --filter=@adelie/api",
    "test:e2e": "pnpm turbo run test:e2e --filter=@adelie/web",
    "test:ui": "pnpm --filter @adelie/web test:ui",
    "check": "pnpm turbo run check --filter=@adelie/web --filter=@adelie/api",
    "check:watch": "pnpm --filter @adelie/web check:watch",
    "initialize": "pnpm install && docker compose up --no-recreate -d && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "lint": "pnpm turbo run lint --filter=@adelie/web --filter=@adelie/api",
    "format": "pnpm turbo run format --filter=@adelie/web --filter=@adelie/api",
    "storybook": "pnpm --filter @adelie/web storybook",
    "site:update": "pnpm --filter @adelie/web site:update"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.26.0"
}
