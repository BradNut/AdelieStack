{
  "name": "adelie-stack-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "db:push": "pnpm --filter @adelie/api db:push",
    "db:generate": "pnpm --filter @adelie/api db:generate",
    "db:migrate": "pnpm --filter @adelie/api db:migrate",
    "db:seed": "pnpm --filter @adelie/api db:seed",
    "db:studio": "pnpm --filter @adelie/api db:studio",
    "turbo": "turbo",
    "dev": "pnpm turbo run dev --filter=@adelie/web --filter=@adelie/api",
    "dev:web": "pnpm --filter @adelie/web dev",
    "dev:api": "pnpm --filter @adelie/api dev",
    "build": "pnpm turbo run build --filter=@adelie/web --filter=@adelie/api",
    "build:web": "pnpm turbo run build --filter=@adelie/web",
    "build:api": "pnpm turbo run build --filter=@adelie/api",
    "preview": "pnpm turbo run preview --filter=@adelie/web --filter=@adelie/api",
    "test:unit": "pnpm turbo run test:unit --filter=@adelie/web",
    "test": "pnpm turbo run test --filter=@adelie/web --filter=@adelie/api",
    "test:e2e:deps": "pnpm --filter @adelie/web test:e2e:deps",
    "test:e2e": "pnpm turbo run test:e2e --filter=@adelie/web",
    "test:e2e:dev": "pnpm --filter @adelie/web test:e2e:dev",
    "test:ui": "pnpm --filter @adelie/web test:ui",
    "test:ui:dev": "pnpm --filter @adelie/web test:ui:dev",
    "check": "pnpm turbo run check --filter=@adelie/web",
    "audit:agent-tokens": "node scripts/audit-agent-doc-tokens.mjs",
    "check:shared-boundaries": "node scripts/check-shared-boundaries.mjs",
    "check:agent-rules": "node scripts/check-agent-rules.mjs",
    "setup:query": "node scripts/setup-tanstack-query.mjs",
    "check:watch": "pnpm --filter @adelie/web check:watch",
    "storage:setup": "bash scripts/setup-seaweedfs.sh",
    "initialize": "pnpm install && docker compose up --no-recreate -d && pnpm storage:setup && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "lint": "pnpm turbo run lint --filter=@adelie/web",
    "format": "pnpm turbo run format --filter=@adelie/web",
    "storybook": "pnpm --filter @adelie/web storybook",
    "site:update": "pnpm --filter @adelie/web site:update",
    "machine-translate": "pnpm --filter @adelie/web machine-translate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "turbo": "2.10.5",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.26.0"
}
