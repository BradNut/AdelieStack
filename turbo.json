{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", ".svelte-kit/**", "dist/**"]
    },
    "@adelie/api#build": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": []
    },
    "@adelie/web#check": {
      "dependsOn": ["^check", "@adelie/api#paraglide:compile"],
      "outputs": []
    },
    "paraglide:compile": {
      "inputs": ["project.inlang/settings.json", "messages/**"],
      "outputs": ["src/lib/paraglide/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "format": {
      "cache": false
    },
    "test:unit": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@adelie/api#test": {
      "dependsOn": [],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    }
  }
}
